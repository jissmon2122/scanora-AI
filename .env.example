# ========================================================
# Scanora Environment Variables (.env)
# ========================================================

# --- Python AI Inference Service (ai_service) ---
SCANORA_AI_API_KEY=scanora-research-token-secure-2026
SCANORA_CHECKPOINTS_DIR=./ai_service/checkpoints
PYTHONPATH=.

# --- Cloudflare Worker & API Gateway ---
INFERENCE_SERVICE_URL=http://127.0.0.1:8000
INFERENCE_SERVICE_API_KEY=scanora-research-token-secure-2026

# --- User Authentication (Optional: leave blank for Clinician Demo Mode) ---
MOCHA_USERS_SERVICE_API_URL=
MOCHA_USERS_SERVICE_API_KEY=
